# --- Rust Specific ---
# The target directory is where all builds, artifacts, and dependencies are stored.
# This can get very large (GBs) and should never be committed.
/target/

# --- Environment Variables & Secrets ---
# Never commit your secrets
.env
.env.local
.env.*.local

# --- IDEs & Editors ---
# JetBrains (IntelliJ, RustRover)
.idea/
*.iml

# VS Code
.vscode/
# Ignore VS Code workspace files, but keep the folder if you have shared settings
# .vscode/*.code-workspace

# Vim
*~
*.swp
*.swo

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Tools ---
# Generated by 'cargo expand'
*.rs.bk

# If using cargo-tarpaulin (code coverage)
tarpaulin-report.html
cargo-tarpaulin-report.json

# If using SQLx offline mode, you usually WANT to commit the .sqlx folder,
# but ignore the temporary build artifacts inside if they exist.
# .sqlx/